# Copy to .env and replace with values for your own deployment.
# Never commit .env or real secrets.

# MySQL connection string for a dedicated development database.
DATABASE_URL=

# Application/authentication values supplied by your configured platform/provider.
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_API_URL=
MANUS_API_URL=
MANUS_API_KEY=

# Email address of the staff account allowed to manage the internal calendar.
# The account must also be authenticated; an admin role is an alternative.
MOTION_CALENDAR_ADMIN_EMAIL=
